# ==============================================================================
# Hiremath Labs — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets, keys, or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Public / Browser Safe)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-app-id:web:your-web-id

# ------------------------------------------------------------------------------
# 2. Greymatter AI Engine API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_GREYMATTER_API_URL=https://api.sujeethiremath.com

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server Only)
# In production (Vercel), provide the JSON string of your service account.
# In local development, either set GOOGLE_APPLICATION_CREDENTIALS or place
# serviceAccount.json in the project root (which is gitignored).
# ------------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=serviceAccount.json

# ------------------------------------------------------------------------------
# 4. Stratus Server & Cloudflare Tunnel Endpoints (Server / API Routes)
# ------------------------------------------------------------------------------
STRATUS_STATUS_URL=https://stratus.sujeethiremath.com/api/status
STRATUS_CAMERA_STREAM_URL=https://camera.sujeethiremath.com/stream.mjpg
STRATUS_AUDIO_STREAM_URL=https://camera.sujeethiremath.com/audio.mp3
STRATUS_WS_TERMINAL_URL=wss://ssh.sujeethiremath.com/ws
STRATUS_TERMINAL_SECRET=your-stratus-terminal-hmac-secret

# ------------------------------------------------------------------------------
# 5. Email Notifications (SMTP / Nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
CONTACT_EMAIL=your-recipient-email@gmail.com

# ------------------------------------------------------------------------------
# 6. Analytics
# ------------------------------------------------------------------------------
MIXPANEL_PROJECT_TOKEN=your-mixpanel-project-token
